# Copy this file to .env and edit it.

# The one shared password you and your friend use to get in.
SITE_PASSWORD=letmein

# Random string used to sign login cookies. Change it.
SESSION_SECRET=change-me-to-something-long-and-random

PORT=3000

# Where the sqlite db + uploaded images live.
DATA_DIR=./data

# Timezone used for displaying dates.
TZ=UTC
